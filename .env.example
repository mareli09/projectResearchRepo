APP_NAME="TUA Research Repository"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tua_repository
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="urdc.repository@tua.edu.ph"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- TUA Research Repository (see CLAUDE.md) ----
# Separate evaluation copy only (section 17). Never true in production.
APP_EVALUATION_COPY=false
TUA_EMAIL_DOMAIN=tua.edu.ph

# Python analytics service (section 11): 127.0.0.1 only, HMAC-signed
ANALYTICS_URL=http://127.0.0.1:8001
ANALYTICS_HMAC_SECRET=
ANALYTICS_TIMEOUT=30

# External LLM (section 10): suggestions only
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=8
LLM_RATE_PER_MINUTE=60

# [Not in manuscript] features: switch off for the evaluated version
FEATURE_LANDING_CMS=true
FEATURE_THEME_PICKER=true
RECOVERY_EMAIL_ENABLED=true
RECOVERY_SMS_ENABLED=false
SMS_PROVIDER=
SMS_API_KEY=

BACKUP_ARCHIVE_PASSWORD=
